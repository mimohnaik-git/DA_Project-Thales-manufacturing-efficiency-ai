{
  "name": "Thales Manufacturing Analytics",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "02_Streamlit_Dashboard/app/app.py"
      ]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },

  "updateContentCommand": "python -m pip install --upgrade pip && python -m pip install -r requirements.txt",

  "postAttachCommand": "streamlit run 02_Streamlit_Dashboard/app/app.py",

  "portsAttributes": {
    "8501": {
      "label": "Streamlit Dashboard",
      "onAutoForward": "openPreview"
    }
  },

  "forwardPorts": [
    8501
  ]
}
