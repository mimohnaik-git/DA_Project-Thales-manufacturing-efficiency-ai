cat > .gitignore << 'EOF'
venv/
__pycache__/
*.pyc
.streamlit/
.DS_Store
EOF

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Environment / secrets
.env
.env.*
!.env.example
*.key
*.pem

# Jupyter
.ipynb_checkpoints/

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
~$*

# Python packaging
build/
dist/
*.egg-info/

# Streamlit secrets
.streamlit/secrets.toml

# Local caches
.cache/
.cache_*/
huggingface/